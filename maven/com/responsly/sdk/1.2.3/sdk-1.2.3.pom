  <!-- that they should prefer consuming it instead. -->
  <!-- do_not_remove: published-with-gradle-metadata -->
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.responsly</groupId>
  <artifactId>sdk</artifactId>
  <version>1.2.3</version>
  <packaging>aar</packaging>
  <name>Responsly Android SDK</name>
  <description>In-app surveys for Android apps: targeted on the device, shown in a native container.</description>
  <url>https://github.com/responsly/responsly-android-sdk</url>
  <inceptionYear>2026</inceptionYear>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>responsly</id>
      <name>Responsly</name>
      <url>https://responsly.com</url>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/responsly/responsly-android-sdk.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/responsly/responsly-android-sdk.git</developerConnection>
    <url>https://github.com/responsly/responsly-android-sdk</url>
  </scm>
  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/responsly/responsly-android-sdk/issues</url>
  </issueManagement>
  <dependencies>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId>
      <version>2.0.21</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>androidx.webkit</groupId>
      <artifactId>webkit</artifactId>
      <version>1.15.0</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>androidx.annotation</groupId>
      <artifactId>annotation</artifactId>
      <version>1.9.1</version>
      <scope>runtime</scope>
    </dependency>
